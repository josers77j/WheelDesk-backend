NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://workshop:change-me-local-only@localhost:5432/workshop?schema=public

JWT_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_PEPPER=replace-with-a-long-random-pepper
# Generate with: pnpm migration:hash --target default-password
DEFAULT_PASSWORD_HASH=

MAIL_FROM=no-reply@example.com
RESEND_API_KEY=replace-me

COOKIE_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_BASE_URL=http://localhost:4200
TRUST_CLOUDFLARE_IP=false

MIGRATION_UNLOCK_PASSWORD_HASH=

# Local Floci credentials only. In AWS, omit endpoint/static credentials and use the Lambda role.
# Original documents and product images in S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET_IMAGES=workshop-product-images
AWS_S3_BUCKET_DOCS=workshop-sale-documents
# Optional S3-compatible endpoint for local development
AWS_ENDPOINT_URL=http://localhost:4566

# Private bucket for original purchase PDF/JSON files (create manually).
AWS_S3_BUCKET_PURCHASES=workshop-purchase-documents

# Initial administrator: generate the hash using the existing password-hash script.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
# Local PostgreSQL container. Keep DATABASE_URL consistent with these values.
POSTGRES_USER=workshop
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=workshop
# Optional Serverless deployment; use your own execution role ARN.
LAMBDA_EXECUTION_ROLE_ARN=

# Change these and the URLs above if the default host ports are already in use.
POSTGRES_PORT=5432
AWS_LOCAL_PORT=4566
