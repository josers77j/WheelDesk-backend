// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Todo: Create index columns

generator client {
  provider      = "prisma-client"
  output = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  
}

enum PaymentTerms {
  CASH // Contado
  CREDIT_15 // Crédito 15 días
  CREDIT_30 // Crédito 30 días
  CREDIT_60 // Crédito 60 días
  PREPAID_50 // 50% anticipo
}

enum ProductType {
  SUPPLY
  TIRE
  SERVICE
}

enum Prefix {
  P
  LT
  ST
  T
}

enum Construction {
  RADIAL @map("R")
  BIAS   @map("D")
  BELTED @map("B")
}

enum LoadRange {
  REINFORCED @map("C")
  EXTRA_LOAD @map("XL")
}

enum TireCondition {
  NEW
  USED
  EMERGENCY
}

enum TireQuality {
  A
  B
  C
  D
}

enum MovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  SALE_REVERSAL
  TRANSFER_ENTRY
  TRANSFER_EXIT
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  COMPLETED
  REJECTED
  ANNULLED
  CONTINGENCY
}

enum SaleType {
  INVOICE
  TAX_CREDIT
}

enum TaxType {
  TAXABLE
  EXEMPT
  NON_TAXABLE
}

enum CustomerType {
  NATURAL
  LEGAL
}

enum SaleRequestStatus {
  PENDING
  COMPLETED
  FAILED
}

// Estado del lote de DTE emitidos en contingencia (MH /fesv/recepcionlote).
// Una contingencia agrupa sus DTE en lotes de hasta 100; el lote se envía y
// luego se consulta hasta que cada documento obtiene (o no) su sello.
model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  createdSales  SaleOrder[] @relation("CreatedSales")
  updatedSales  SaleOrder[] @relation("UpdatedSales")
  canceledSales SaleOrder[] @relation("CanceledSales")

  createdPurchases  PurchaseOrder[] @relation("CreatedPurchases")
  updatedPurchases  PurchaseOrder[] @relation("UpdatedPurchases")
  canceledPurchases PurchaseOrder[] @relation("CanceledPurchases")

  createdProducts Product[] @relation("CreatedProducts")
  updatedProducts Product[] @relation("UpdatedProducts")

  createdTires Tire[] @relation("CreatedTires")
  updatedTires Tire[] @relation("UpdatedTires")

  createdTransfers Transfer[] @relation("CreatedTransfers")

  createdCustomers Customer[] @relation("CreatedCustomers")

  inventoryMovements InventoryMovement[]
  SaleReturn         SaleReturn[]
  PurchaseReturn     PurchaseReturn[]
  refreshToken       RefreshTokens[]
  loginAttemptLocks  LoginAttemptLock[]  @relation("LoginLockUnlockedBy")

  auditLogs AuditLog[] @relation("AuditLogs")

  role UserRole @default(ADMIN)
}

model LoginAttemptLock {
  id                Int       @id @default(autoincrement())
  ipAddress         String    @unique @db.VarChar(45)
  failedAttempts    Int       @default(0)
  lockLevel         Int       @default(0)
  lockedUntil       DateTime?
  permanentlyLocked Boolean   @default(false)
  lastFailedAt      DateTime?
  unlockedAt        DateTime?
  unlockedBy        Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  unlockedByUser User? @relation("LoginLockUnlockedBy", fields: [unlockedBy], references: [id], onDelete: SetNull)

  @@index([lockedUntil])
}

enum UserRole {
  ADMIN
  SELLER
  VIEWER
  ACCOUNTANT
}

model RefreshTokens {
  id        String @id @unique @default(uuid())
  userId    Int
  tokenHash String @db.VarChar(255)

  userAgent  String
  deviceType String @db.VarChar(50)
  ipAddress  String @db.VarChar(45)

  country String? @db.VarChar(100)
  city    String? @db.VarChar(100)

  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?   @db.Text
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?
  deletedAt   DateTime?
}

model Provider {
  nrc         String? @unique @db.VarChar(30)
  nit         String? @unique @db.VarChar(30)
  phone       String? @db.VarChar(30)
  email       String? @db.VarChar(254)
  id          Int             @id @default(autoincrement())
  name        String
  description String?         @db.Text
  products    Product[]
  purchases   PurchaseOrder[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime?
  deletedAt   DateTime?
}

model Product {
  id            Int         @id @default(autoincrement())
  name          String
  sku           String?     @unique
  type          ProductType
  purchasePrice Decimal?    @db.Decimal(14, 4)
  salePrice     Decimal?    @db.Decimal(18, 8)
  taxType       TaxType     @default(TAXABLE)

  stock       Int      @default(0)
  averageCost Decimal? @db.Decimal(14, 2)

  notes      String?   @db.Text
  brandId    Int?
  providerId Int?
  brand      Brand?    @relation(fields: [brandId], references: [id])
  provider   Provider? @relation(fields: [providerId], references: [id])
  tire       Tire?

  createdById Int?
  updatedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Catálogos DTE
  itemTypeCatalogId      Int
  unitOfMeasureCatalogId Int

  itemTypeCatalog      ElectronicInvoiceItemTypeCatalog      @relation(fields: [itemTypeCatalogId], references: [id])
  unitOfMeasureCatalog ElectronicInvoiceUnitOfMeasureCatalog @relation(fields: [unitOfMeasureCatalogId], references: [id])
  createdBy            User?                                 @relation("CreatedProducts", fields: [createdById], references: [id])
  updatedBy            User?                                 @relation("UpdatedProducts", fields: [updatedById], references: [id])

  images               ProductImage[]
  movements            InventoryMovement[]
  saleItems            SaleOrderDetail[]
  purchaseItems        PurchaseOrderDetail[]
  quotationDetails     QuotationDetail[]
  SaleReturnDetail     SaleReturnDetail[]
  PurchaseReturnDetail PurchaseReturnDetail[]
  ProductZoneStock     ProductZoneStock[]
  productVehicleType   ProductVehicleType[]
  transferDetails      TransferDetail[]
}

model Tire {
  id             Int            @id @default(autoincrement())
  productId      Int            @unique
  prefix         Prefix?
  width          Int
  aspectRatio    Int?
  construction   Construction   @default(RADIAL)
  rimDiameter    Decimal        @db.Decimal(4, 1)
  loadIndexFront Int?
  loadIndexRear  Int?
  speedRating    String?        @db.Char(1)
  loadRange      LoadRange?
  plies          Int?
  condition      TireCondition?
  quality        TireQuality    @default(D)
  createdById    Int?
  updatedById    Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product   Product @relation(fields: [productId], references: [id])
  createdBy User?   @relation("CreatedTires", fields: [createdById], references: [id])
  updatedBy User?   @relation("UpdatedTires", fields: [updatedById], references: [id])
}

model ProductVehicleType {
  productId     Int
  vehicleTypeId Int
  product       Product     @relation(fields: [productId], references: [id])
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@id([productId, vehicleTypeId])
}

model VehicleType {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(30)
  ProductVehicleType ProductVehicleType[]

  deleteAt DateTime?
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  url       String
  key       String
  order     Int?    @default(0)

  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Warehouse {
  purchaseOrders PurchaseOrder[]
  id        Int                 @id @default(autoincrement())
  name      String
  address   String?
  movements InventoryMovement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  zones     Zone[]
}

model Zone {
  id          Int    @id @default(autoincrement())
  warehouseId Int
  name        String

  warehouse            Warehouse             @relation(fields: [warehouseId], references: [id])
  stocks               ProductZoneStock[]
  movements            InventoryMovement[]
  purchaseOrderDetails PurchaseOrderDetail[]
  saleOrderDetails     SaleOrderDetail[]
  fromTransfers        Transfer[]            @relation("TransferFromZone")
  toTransfers          Transfer[]            @relation("TransferToZone")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([warehouseId, name])
}

model ProductZoneStock {
  id        Int @id @default(autoincrement())
  productId Int
  zoneId    Int
  quantity  Int @default(0)

  product Product @relation(fields: [productId], references: [id])
  zone    Zone    @relation(fields: [zoneId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([productId, zoneId])
}

model InventoryMovement {
  id        Int          @id @default(autoincrement())
  productId Int
  type      MovementType

  note        String?  @db.Text
  warehouseId Int?
  userId      Int?
  createdAt   DateTime @default(now())

  // kardex fields
  unitCost        Decimal @db.Decimal(14, 4)
  totalCost       Decimal @db.Decimal(14, 2)
  balanceQuantity Int
  quantity        Int
  balanceValue    Decimal @db.Decimal(14, 2)
  averageCost     Decimal @db.Decimal(14, 2)

  //Relationship with
  purchaseOrderId     Int?
  saleOrderId         Int?
  saleReturnId        Int?
  purchaseReturnId    Int?
  zoneId              Int?
  zoneBalanceQuantity Int?

  purchaseOrder  PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  saleOrder      SaleOrder?      @relation(fields: [saleOrderId], references: [id])
  saleReturn     SaleReturn?     @relation(fields: [saleReturnId], references: [id])
  purchaseReturn PurchaseReturn? @relation(fields: [purchaseReturnId], references: [id])

  product   Product    @relation(fields: [productId], references: [id])
  zone      Zone?      @relation(fields: [zoneId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  Warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([productId, createdAt])
  @@index([purchaseOrderId])
  @@index([saleOrderId])
}

model SaleOrder {
  id         Int  @id @default(autoincrement())
  customerId Int?

  requestId      String? @unique
  documentNumber String  @unique

  SaleType         SaleType
  documentType     String
  documentTypeCode String
  documentTypeId   Int?

  subtotal       Decimal @db.Decimal(14, 2)
  iva            Decimal @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)
  globalDiscount Decimal @default(0) @db.Decimal(14, 2)

  status OrderStatus @default(PENDING)

  externalInvoiceId String? @unique

  isLegacy Boolean @default(false)

  customerName           String?
  customerDocumentType   String?
  customerDocumentNumber String?
  customerNrc            String?
  customerAddress        String?
  customerDistrict       String?

  canceledById   Int?
  createdById    Int?
  updatedById    Int?
  quotationId    Int?
  rejectedFromId Int?

  customer     Customer?   @relation(fields: [customerId], references: [id])
  canceledBy   User?       @relation("CanceledSales", fields: [canceledById], references: [id])
  createdBy    User?       @relation("CreatedSales", fields: [createdById], references: [id])
  updatedBy    User?       @relation("UpdatedSales", fields: [updatedById], references: [id])
  quotation    Quotation?  @relation(fields: [quotationId], references: [id])
  rejectedFrom SaleOrder?  @relation("RejectionChain", fields: [rejectedFromId], references: [id])
  rejections   SaleOrder[] @relation("RejectionChain")

  documentTypeCatalog ElectronicInvoiceDocumentTypeCatalog? @relation(fields: [documentTypeId], references: [id])

  payments           SaleOrderPayment[]
  document           SaleOrderDocument?
  details            SaleOrderDetail[]
  inventoryMovements InventoryMovement[]
  SaleReturn         SaleReturn[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  canceledAt DateTime?

  issuedAt DateTime           @default(now())
  paidAt   DateTime?
  requests SaleOrderRequest[]

  @@index([customerId, status, createdAt])
}

model SaleOrderDetail {
  id          Int     @id @default(autoincrement())
  saleOrderId Int
  productName String
  productId   Int
  quantity    Int
  taxType     TaxType @default(TAXABLE)

  subtotal            Decimal @db.Decimal(18, 8)
  discountAmount      Decimal @default(0) @db.Decimal(18, 8)
  amountAfterDiscount Decimal @db.Decimal(18, 8) // Total neto de la linea

  unitPrice     Decimal @db.Decimal(18, 8)
  netDiscount   Decimal @db.Decimal(18, 8)
  taxAmount     Decimal @db.Decimal(18, 8) // El valor del IVA extraído
  taxableAmount Decimal @db.Decimal(18, 8) // El valor real de la venta sin el IVA
  unitPriceNet  Decimal @db.Decimal(18, 8)

  itemTypeCatalogId      Int
  unitOfMeasureCatalogId Int
  itemTypeCatalog        ElectronicInvoiceItemTypeCatalog      @relation(fields: [itemTypeCatalogId], references: [id])
  unitOfMeasureCatalog   ElectronicInvoiceUnitOfMeasureCatalog @relation(fields: [unitOfMeasureCatalogId], references: [id])

  zoneId Int
  zone   Zone @relation(fields: [zoneId], references: [id])

  product   Product   @relation(fields: [productId], references: [id])
  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id])

  @@index([saleOrderId])
  @@index([zoneId])
}

model PurchaseOrder {
  destinationWarehouseId Int?
  destinationWarehouse Warehouse? @relation(fields: [destinationWarehouseId], references: [id])
  requestId String? @unique
  sourceIdentity String? @unique
  document PurchaseOrderDocument?
  attempt PurchaseOrderAttempt?
  id Int @id @default(autoincrement())

  documentNumber Int @unique @default(autoincrement())

  providerId   Int
  total        Decimal     @db.Decimal(14, 2)
  status       OrderStatus @default(PENDING)
  canceledById Int?
  createdById  Int?
  updatedById  Int?

  canceledBy User? @relation("CanceledPurchases", fields: [canceledById], references: [id])
  createdBy  User? @relation("CreatedPurchases", fields: [createdById], references: [id])
  updatedBy  User? @relation("UpdatedPurchases", fields: [updatedById], references: [id])

  details  PurchaseOrderDetail[]
  provider Provider              @relation(fields: [providerId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  canceledAt DateTime?

  PurchaseReturn     PurchaseReturn[]
  inventoryMovements InventoryMovement[]

  @@index([providerId, status, createdAt])
}

model PurchaseOrderDetail {
  id              Int     @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  quantity        Int
  unitPrice       Decimal @db.Decimal(14, 4)
  subtotal        Decimal @db.Decimal(14, 2)
  suggestedZoneId Int?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  suggestedZone Zone?         @relation(fields: [suggestedZoneId], references: [id])

  @@index([purchaseOrderId])
}

model SaleReturn {
  id          Int      @id @default(autoincrement())
  saleOrderId Int
  reason      String?  @db.Text
  total       Decimal  @db.Decimal(14, 2)
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  saleOrder          SaleOrder           @relation(fields: [saleOrderId], references: [id])
  details            SaleReturnDetail[]
  inventoryMovements InventoryMovement[]
}

model SaleReturnDetail {
  id           Int     @id @default(autoincrement())
  saleReturnId Int
  productId    Int
  quantity     Int
  unitPrice    Decimal @db.Decimal(14, 4)
  subtotal     Decimal @db.Decimal(14, 2)

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
}

model PurchaseReturn {
  id              Int      @id @default(autoincrement())
  purchaseOrderId Int
  reason          String?  @db.Text
  total           Decimal  @db.Decimal(14, 2)
  createdById     Int?
  createdBy       User?    @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  details            PurchaseReturnDetail[]
  inventoryMovements InventoryMovement[]
}

model PurchaseReturnDetail {
  id               Int     @id @default(autoincrement())
  purchaseReturnId Int
  productId        Int
  quantity         Int
  unitPrice        Decimal @db.Decimal(14, 4)
  subtotal         Decimal @db.Decimal(14, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])
}

model Customer {
  id Int @id @default(autoincrement())

  name String @unique

  isTaxPayer Boolean

  email String?
  phone String?

  customerType CustomerType

  districtId Int?

  address  String?
  district District? @relation(fields: [districtId], references: [id])

  taxInfo CustomerTaxInfo?

  createdById Int?
  createdBy   User? @relation("CreatedCustomers", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sales      SaleOrder[]
  quotations Quotation[]
}

model ElectronicInvoiceTaxDocumentTypeCatalog {
  id Int @id @default(autoincrement())

  code String @unique
  name String

  isActive Boolean

  customers                  CustomerTaxInfo[]
  responsibleCompanySettings CompanySettings[] @relation("CompanySettingsResponsibleDocType")
}

model ElectronicInvoiceEconomicActivityCatalog {
  id Int @id @default(autoincrement())

  code String? @unique
  name String

  isActive Boolean
  isLegacy Boolean @default(false)

  companySettings CompanySettings[]
  customers       CustomerTaxInfo[]
}

model CustomerTaxInfo {
  id Int @id @default(autoincrement())

  tradeName  String?
  customerId Int      @unique
  customer   Customer @relation(fields: [customerId], references: [id])

  taxDocumentTypeId Int
  taxDocumentType   ElectronicInvoiceTaxDocumentTypeCatalog @relation(fields: [taxDocumentTypeId], references: [id])

  taxDocumentNumber String  @unique
  nrc               String?

  economicActivityId Int
  economicActivity   ElectronicInvoiceEconomicActivityCatalog @relation(fields: [economicActivityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxDocumentTypeId, taxDocumentNumber])
}

model CompanySettings {
  id Int @id @default(autoincrement())

  legalName  String
  tradeName  String?
  nit        String
  nrc        String?
  registryNo String?

  address String

  districtId Int

  EstablishmentMHCode String
  salePointMHCode     String

  establishmentTypeCatalogId Int?

  district District @relation(fields: [districtId], references: [id])

  establishmentTypeCatalog ElectronicInvoiceEstablishmentTypeCatalog? @relation(fields: [establishmentTypeCatalogId], references: [id])

  economicActivityId Int
  economicActivity   ElectronicInvoiceEconomicActivityCatalog @relation(fields: [economicActivityId], references: [id])

  phone   String
  email   String
  website String?

  // Indicates that new documents for this establishment must use contingency
  // routing until the active window is finalized.
  isContingency Boolean @default(false)

  // Responsable del establecimiento que informa los Eventos DTE (Contingencia / Invalidación).
  // CAT-022 for responsableDocType; see normativa for responsableDocNumber length.
  responsableName           String?                                  @db.VarChar(150)
  responsableDocTypeId      Int?
  responsableDocTypeCatalog ElectronicInvoiceTaxDocumentTypeCatalog? @relation("CompanySettingsResponsibleDocType", fields: [responsableDocTypeId], references: [id])
  responsableDocNumber      String?                                  @db.VarChar(25)

  ivaRate Decimal @default(0.13) @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([establishmentTypeCatalogId])
}

model Department {
  id Int @id @default(autoincrement())

  code         String @unique
  externalCode String @unique
  name         String

  municipalities Municipality[]

  createdAt DateTime @default(now())
}

model Municipality {
  id           Int    @id @default(autoincrement())
  code         String @unique
  externalCode String
  name         String

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  districts District[]

  createdAt DateTime @default(now())

  @@unique([departmentId, externalCode])
}

model District {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  name      String
  agentCode String?

  municipalityId Int
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  createdAt       DateTime          @default(now())
  customers       Customer[]
  companySettings CompanySettings[]

  @@index([municipalityId])
}

// Lote de DTE emitidos en contingencia (MH /fesv/recepcionlote, máximo 100 DTE
// por lote). Una contingencia con más de 100 documentos se particiona en varios
// lotes; cada lote se envía y consulta de forma independiente.
// MH CATALOGS

model ElectronicInvoiceDocumentTypeCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(2) // CAT-002
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleOrders SaleOrder[]
}

model ElectronicInvoiceBillingModelCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(2) // CAT-003
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ElectronicInvoiceTransmissionTypeCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(2) // CAT-004
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ElectronicInvoiceContingencyTypeCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(2) // CAT-005
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ElectronicInvoiceEstablishmentTypeCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(2) // CAT-009
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companySettings CompanySettings[]
}

model ElectronicInvoiceItemTypeCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(2) // CAT-011
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  isLegacy  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Product         Product[]
  saleOrderDetail SaleOrderDetail[]
}

model ElectronicInvoiceUnitOfMeasureCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(3) // CAT-014
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true)
  isLegacy  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Product         Product[]
  saleOrderDetail SaleOrderDetail[]
}

model ElectronicInvoiceTributeCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(4) // CAT-015
  name      String   @db.VarChar(180)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ElectronicInvoiceOperationConditionCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(2) // CAT-016
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ElectronicInvoicePaymentMethodCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(2) // CAT-017
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  isLegacy  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleOrderPayments SaleOrderPayment[]
}

model ElectronicInvoicePaymentTermCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(2) // CAT-018
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  isLegacy  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleOrderPayments SaleOrderPayment[]
}

model ElectronicInvoiceOtherAssociatedDocumentCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(2) // CAT-021
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ElectronicInvoiceContingencyDocumentTypeCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(2) // CAT-023
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ElectronicInvoiceInvalidationTypeCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(2) // CAT-024
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleOrderRequest {
  id Int @id @default(autoincrement())

  requestId   String            @unique @db.VarChar(36) // UUID enviado por frontend
  saleOrderId Int
  status      SaleRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Restrict)

  @@index([saleOrderId, createdAt])
}

model Quotation {
  id Int @id @default(autoincrement())

  documentNumber String @unique

  customerId Int?
  saleType   SaleType?

  subtotal       Decimal @db.Decimal(14, 2)
  iva            Decimal @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)
  globalDiscount Decimal @default(0) @db.Decimal(14, 2)

  customerName    String?
  customerAddress String?

  notes String? @db.Text

  createdById Int?
  updatedById Int?

  customer Customer? @relation(fields: [customerId], references: [id])

  details    QuotationDetail[]
  saleOrders SaleOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, createdAt])
}

model QuotationDetail {
  id          Int     @id @default(autoincrement())
  quotationId Int
  productId   Int
  productName String
  quantity    Int
  taxType     TaxType @default(TAXABLE)

  unitPrice           Decimal @db.Decimal(18, 8)
  subtotal            Decimal @db.Decimal(18, 8)
  discountAmount      Decimal @default(0) @db.Decimal(18, 8)
  amountAfterDiscount Decimal @db.Decimal(18, 8)

  taxAmount     Decimal @db.Decimal(18, 8)
  taxableAmount Decimal @db.Decimal(18, 8)
  unitPriceNet  Decimal @db.Decimal(18, 8)
  netDiscount   Decimal @db.Decimal(18, 8)

  quotation Quotation @relation(fields: [quotationId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
}

model QuotationSequence {
  id            Int @id @default(autoincrement())
  currentNumber Int @default(0)
}

model Transfer {
  id          Int            @id @default(autoincrement())
  fromZoneId  Int
  toZoneId    Int
  status      TransferStatus @default(PENDING)
  createdById Int?

  fromZone  Zone  @relation("TransferFromZone", fields: [fromZoneId], references: [id])
  toZone    Zone  @relation("TransferToZone", fields: [toZoneId], references: [id])
  createdBy User? @relation("CreatedTransfers", fields: [createdById], references: [id])

  details TransferDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromZoneId])
  @@index([toZoneId])
  @@index([status, createdAt])
}

model TransferDetail {
  id         Int @id @default(autoincrement())
  transferId Int
  productId  Int
  quantity   Int

  transfer Transfer @relation(fields: [transferId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([transferId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  at         DateTime @default(now())
  userId     Int?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ip         String?

  user User? @relation("AuditLogs", fields: [userId], references: [id])

  @@index([entityType, entityId, at])
  @@index([userId, at])
  @@index([action, at])
}

model SaleOrderPayment {
  id                     Int                                   @id @default(autoincrement())
  saleOrderId            Int
  paymentMethodCatalogId Int
  paymentTermCatalogId   Int?
  paymentReference       String?                               @db.VarChar(100)
  termValue              Int?
  amount                 Decimal                               @db.Decimal(14, 2)
  rawAmount              Decimal                               @db.Decimal(14, 2)
  createdAt              DateTime                              @default(now())
  updatedAt              DateTime                              @updatedAt
  saleOrder              SaleOrder                             @relation(fields: [saleOrderId], references: [id], onDelete: Restrict)
  paymentMethodCatalog   ElectronicInvoicePaymentMethodCatalog @relation(fields: [paymentMethodCatalogId], references: [id])
  paymentTermCatalog     ElectronicInvoicePaymentTermCatalog?  @relation(fields: [paymentTermCatalogId], references: [id])

  @@index([saleOrderId])
}

model SaleOrderDocument {
  id           Int       @id @default(autoincrement())
  saleOrderId  Int       @unique
  pdfKey       String?
  jsonKey      String
  pdfFilename  String?
  jsonFilename String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  saleOrder    SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Restrict)
}

model PurchaseOrderDocument {
  id Int @id @default(autoincrement())
  purchaseOrderId Int @unique
  pdfKey String?
  jsonKey String?
  pdfFilename String?
  jsonFilename String?
  source String
  sourceSnapshot Json?
  createdAt DateTime @default(now())
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

model PurchaseOrderAttempt {
  requestId String @id
  actorId Int
  payloadHash String
  pdfKey String?
  jsonKey String?
  status String @default("PENDING")
  purchaseOrderId Int? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
}
